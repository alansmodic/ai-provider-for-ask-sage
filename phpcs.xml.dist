<?xml version="1.0"?>
<ruleset name="AI Provider for Ask Sage">
	<description>Coding standards for the Ask Sage AI provider plugin.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="WordPress-VIP-Go"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="ai-provider-for-ask-sage"/>
		</properties>
	</rule>

	<!-- SDK contracts require camelCase method names. -->
	<rule ref="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid">
		<exclude-pattern>/includes/*</exclude-pattern>
	</rule>

	<config name="minimum_wp_version" value="7.0"/>
	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
